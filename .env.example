# Runtime
SILKGUARD_MODE=local-first
SILKGUARD_DATA_DIR=
SILKGUARD_DB_PATH=

# Optional AI explanation provider. Leave blank for deterministic local fallback.
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Feishu: https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_TABLE_ID=

# Amazon Selling Partner API:
# https://sellercentral.amazon.com/sellingpartner/developerconsole
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_REGION=eu

# Optional local OCR. Install PaddleOCR separately only when needed.
OCR_PROVIDER=local_optional
